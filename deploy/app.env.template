# Copy to /etc/legacy-viewer/app.env on the server, fill in, then:  sudo chmod 600 + chown root.
# PLACEHOLDERS ONLY. Never commit a filled-in copy (the .gitignore and CI secret scan block it).
# Meaning of every setting: docs/DEPLOYMENT_PLAN.md section 3.6 and docs/SECURITY.md section 2.6.

APP_ENV=production
ALLOWED_HOSTS=records.example.org
USE_FAKE_DATA=false
COOKIE_SECURE=true
# 64+ random characters, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=<generate>

# Archive SQL Server: the READ-ONLY login (DEPLOYMENT_PLAN.md section 4).
SQL_HOST=<sql-server-host>
SQL_PORT=1433
SQL_USER=legacy_viewer_ro
SQL_PASSWORD=<from-secrets-manager>
SQL_TRUST_SERVER_CERTIFICATE=false
EMR_DATABASE=EMR
NTIER_DATABASE=Ntier_0010060
DMZ_DATABASE=DMZ

# App database (RDS PostgreSQL recommended). TLS required.
APP_DATABASE_URL=postgresql+psycopg://legacy_app:<password>@<rds-endpoint>:5432/legacy_viewer?sslmode=require

CLINIC_NAME=<Clinic name>
CLINIC_TZ=America/New_York
FEATURE_LEGACY_DMZ=true

# Scanned pages: paths INSIDE the container (docker-compose.prod.yml mounts the host copies there).
# Leave empty until the shares are copied; the Documents tabs then list metadata only.
SCAN_ROOT=
SCAN_UNC_PREFIX=\\amhs-db1\hmscan
LEGACY_SCAN_ROOT=
LEGACY_SCAN_UNC_PREFIX=\\w10060-1\images

# Load balancer addresses allowed to set X-Forwarded-For (the VPC CIDR or the ALB subnets).
FORWARDED_ALLOW_IPS=10.0.0.0/16
WEB_CONCURRENCY=3
