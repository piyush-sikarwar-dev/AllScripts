# Copy to .env and fill in. Never commit .env.

# --- Source SQL Server (one instance, one read-only login) ---
SQL_HOST=sqlserver.example.internal
SQL_PORT=1433
SQL_USER=readonly_login
SQL_PASSWORD=change-me
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_SERVER_CERTIFICATE=false
EMR_DATABASE=EMR
NTIER_DATABASE=Ntier_0010060
DMZ_DATABASE=DMZ

# --- App database (PostgreSQL) ---
APP_DATABASE_URL=postgresql+psycopg://legacy:change-me@localhost:5432/legacy_viewer

# --- Sessions / cookies ---
SESSION_SECRET=generate-a-long-random-string
COOKIE_SECURE=true

# --- Clinic ---
CLINIC_NAME=Example Clinic
CLINIC_TZ=America/New_York

# --- Scanned documents (leave empty until the scan share is mounted) ---
SCAN_ROOT=
SCAN_UNC_PREFIX=\\amhs-db1\hmscan

# --- Features ---
FEATURE_LEGACY_DMZ=false
USE_FAKE_DATA=true
